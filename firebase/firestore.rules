rules_version = '2';

// Every read and write in this app goes through server code using the
// Firebase Admin SDK (Next.js API routes for the public booking flow,
// Server Actions for the admin panel — both authenticated separately: a
// rate-limited honeypot check for the public side, a verified session
// cookie for the admin side). The Admin SDK bypasses these rules entirely,
// so the browser client never talks to Firestore directly — deny it
// everything.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
